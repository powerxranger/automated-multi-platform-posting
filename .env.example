# =============================================================================
# Automated Multi-Platform Posting - environment template
# Copy to `.env` and fill in the platforms you want. Every platform is optional:
# adapters whose credentials are missing are reported as "unavailable" instead
# of failing the request. Never commit `.env`.
#   PowerShell : Copy-Item .env.example .env
#   bash       : cp .env.example .env
# =============================================================================

# ----------------------------- Application ----------------------------------
APP_NAME="Automated Multi-Platform Posting"
APP_VERSION="1.0.0"
ENVIRONMENT="local"
LOG_LEVEL="INFO"

# Timezone used for the `date` / `time` fields in the response (IANA name).
APP_TIMEZONE="Asia/Kolkata"

# Reliability knobs
CONNECT_TIMEOUT_SECONDS=5
REQUEST_TIMEOUT_SECONDS=15
MAX_CONCURRENT_PLATFORMS=5
MAX_RETRIES=1
RETRY_BACKOFF_SECONDS=0.5

# Verify that the published URL is reachable without authentication.
PUBLIC_CHECK_ENABLED=true
PUBLIC_CHECK_TIMEOUT_SECONDS=8

# Idempotency-Key cache lifetime (0 disables the cache).
IDEMPOTENCY_TTL_SECONDS=600

# Comma-separated platform ids to enable. Empty = every configured platform.
# Example: ENABLED_PLATFORMS="bluesky,mastodon,telegram,devto,gist"
ENABLED_PLATFORMS=""

# ----------------------------- 1. Bluesky -----------------------------------
# bsky.app -> Settings -> App Passwords -> Add App Password
BLUESKY_HANDLE=""
BLUESKY_APP_PASSWORD=""
BLUESKY_PDS_URL="https://bsky.social"

# ----------------------------- 2. Mastodon ----------------------------------
# Preferences -> Development -> New application -> scopes: write:statuses
MASTODON_INSTANCE_URL=""
MASTODON_ACCESS_TOKEN=""
MASTODON_VISIBILITY="public"

# ----------------------------- 3. Telegram ----------------------------------
# @BotFather -> /newbot -> token. Bot must be an ADMIN of a PUBLIC channel.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHANNEL="https://t.me/your_public_channel"

# ----------------------------- 4. Dev.to ------------------------------------
# dev.to -> Settings -> Extensions -> DEV Community API Keys
DEVTO_API_KEY=""
DEVTO_TAGS=""

# ----------------------------- 5. GitHub Gist -------------------------------
# github.com -> Settings -> Developer settings -> Personal access tokens
# Fine-grained token with the "Gists" permission (read + write) is enough.
GITHUB_TOKEN=""
GITHUB_GIST_PUBLIC=true
